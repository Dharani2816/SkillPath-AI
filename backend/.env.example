# PostgreSQL connection — replace USER, PASSWORD and the port if yours differ
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/skillpath_ai?schema=public"

PORT=5000
JWT_SECRET="change-me-for-anything-beyond-a-demo"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# Optional LLM. Leave LLM_API_KEY empty to use the offline demo counsellor engine.
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER="anthropic"
LLM_API_KEY=""
LLM_MODEL=""
LLM_BASE_URL=""
